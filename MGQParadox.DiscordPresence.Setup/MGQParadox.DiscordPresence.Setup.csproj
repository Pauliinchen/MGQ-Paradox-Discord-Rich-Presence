<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Discord\Uninstall.exe, which the player opens: removes the mod and whatever its earlier
    versions left behind, including their block in Patch/Patch.rb. The game never starts it.

    .NET Framework 4.8 on purpose: it is part of every Windows 10/11, so players need nothing
    installed. Packaged by the MGQParadox.DiscordPresence project.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Uninstall</AssemblyName>
    <RootNamespace>MGQParadox.DiscordPresence.Setup</RootNamespace>
    <Product>Monster Girl Quest! Paradox RPG Discord Rich Presence</Product>
    <Version>0.0.0-dev</Version>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>   <!-- no Uninstall.exe.config -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Shared with the DLL, so the folder rules and the log exist only once. -->
  <ItemGroup>
    <Compile Include="..\MGQParadox.DiscordPresence\ModFolder.cs" Link="Shared\ModFolder.cs" />
    <Compile Include="..\MGQParadox.DiscordPresence\Log.cs" Link="Shared\Log.cs" />
  </ItemGroup>

</Project>
