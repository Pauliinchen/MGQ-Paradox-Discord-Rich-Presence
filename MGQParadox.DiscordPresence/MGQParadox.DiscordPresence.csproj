<Project Sdk="Microsoft.NET.Sdk">

  <!-- Publish assembles the release layout in Shipping\, see docs/DEVELOPER.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DiscordPresence</AssemblyName>
    <RootNamespace>MGQParadox.DiscordPresence</RootNamespace>
    <Product>Monster Girl Quest! Paradox RPG Discord Rich Presence</Product>
    <Version>0.0.0-dev</Version>

    <!-- The game is a 32-bit process and only loads a native DLL of its own kind. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>

    <PackageDir>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), .., Shipping))</PackageDir>
    <ZipFile>$(MSBuildProjectDirectory)\bin\$(Configuration)\MGQ-Paradox-Discord-RPC-$(Version).zip</ZipFile>
  </PropertyGroup>

  <ItemGroup>
    <ModFile Include="..\package\Discord\*" />
    <PatchFile Include="..\GameScript\Discord_RPC.rb" />

    <None Include="@(ModFile)" Link="Shipped\Discord\%(Filename)%(Extension)" />
    <None Include="@(PatchFile)" Link="Shipped\Patch\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="AssemblePackage" AfterTargets="Publish">
    <RemoveDir Directories="$(PackageDir)" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).dll;@(ModFile)" DestinationFolder="$(PackageDir)Discord" />
    <Copy SourceFiles="@(PatchFile)" DestinationFolder="$(PackageDir)Patch" />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(PackageDir)" />
  </Target>

  <Target Name="ZipPackage" AfterTargets="AssemblePackage" Condition="'$(Configuration)' == 'Release'">
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="$(ZipFile)" Overwrite="true" />
  </Target>

</Project>
